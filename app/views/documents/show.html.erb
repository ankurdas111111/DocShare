<h1><%= @document.title %></h1>

<p>
  Uploaded by <%= @document.user.name %> — <%= time_ago_in_words(@document.created_at) %> ago
</p>

<%= link_to "Back to Dashboard", root_path %>

<hr>

<h3>Share</h3>

<% if @document.share.present? %>
  <p>
    Share link:
    <input type="text" value="<%= shared_document_url(@document.share.token) %>" readonly style="width: 400px;" id="share-link">
  </p>
<% else %>
  <%= button_to "Generate Share Link", document_share_path(@document), method: :post %>
<% end %>

<hr>

<div style="display: flex; gap: 20px;">
  <%# PDF Viewer %>
  <div style="flex: 1;">
    <% if @document.file.attached? %>
      <iframe
        src="<%= rails_blob_path(@document.file, disposition: "inline") %>"
        width="100%"
        height="800px"
        style="border: 1px solid #ccc;">
      </iframe>
    <% end %>
  </div>

  <%# Comments Sidebar %>
  <div style="width: 350px; max-height: 800px; overflow-y: auto; border-left: 1px solid #ccc; padding-left: 16px;">
    <h3>Comments (<%= @document.comments.count %>)</h3>

    <%= render partial: "comments/form", locals: { document: @document, hide_guest_name: true } %>

    <hr>

    <% if @document.comments.any? %>
      <%= render partial: "comments/comment", collection: @document.comments.order(created_at: :desc) %>
    <% else %>
      <p style="color: #999;">No comments yet.</p>
    <% end %>
  </div>
</div>
