<div class="doc-header">
  <h1><%= @document.title %></h1>
</div>
<p class="doc-header__meta">
  Uploaded by <%= @document.user.name %> · <%= time_ago_in_words(@document.created_at) %> ago
</p>

<div class="doc-actions">
  <%= link_to "← Dashboard", root_path %>
  <%= button_to "Delete", document_path(@document), method: :delete,
      class: "btn btn-danger btn-sm",
      data: { turbo_confirm: "Are you sure? This will permanently delete this PDF and all its comments." } %>
</div>

<div class="share-section">
  <h3>Share</h3>
  <% if @document.share.present? && @document.share.active? %>
    <div class="share-link-group">
      <label for="share-link" class="sr-only">Share link</label>
      <input type="text" value="<%= shared_document_url(@document.share.token) %>" readonly id="share-link" aria-label="Share link">
      <button type="button" class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('share-link').value);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">Copy</button>
    </div>
    <% if @document.share.expires_at.present? %>
      <p class="share-meta">Expires <%= time_ago_in_words(@document.share.expires_at) %> from now (<%= @document.share.expires_at.strftime("%b %d, %Y") %>)</p>
    <% end %>

    <%= form_with(url: document_share_path(@document), method: :post, local: true, class: "share-email-form") do |f| %>
      <%= f.email_field :recipient_email, placeholder: "Email address to invite (optional)", class: "share-email-input", aria: { label: "Recipient email" } %>
      <%= f.submit "Send Invite", class: "btn btn-secondary btn-sm" %>
    <% end %>

    <%= button_to "Revoke Share Link", document_share_path(@document), method: :delete,
        class: "btn btn-danger btn-sm",
        data: { turbo_confirm: "Revoke this share link? Anyone with the link will lose access." } %>
  <% else %>
    <%= form_with(url: document_share_path(@document), method: :post, local: true, class: "share-generate-form") do |f| %>
      <%= f.email_field :recipient_email, placeholder: "Email address to invite (optional)", class: "share-email-input", aria: { label: "Recipient email" } %>
      <%= f.submit "Generate Share Link", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
</div>

<div class="pdf-layout"
     data-controller="pdf-viewer"
     data-pdf-viewer-url-value="<%= rails_blob_path(@document.file, disposition: "inline") %>">

  <%# PDF Viewer %>
  <div class="pdf-viewer">
    <p class="pdf-viewer__info" data-pdf-viewer-target="pageInfo"></p>
    <div class="pdf-viewer__container" data-pdf-viewer-target="container">
      <p class="pdf-viewer__loading">Loading PDF...</p>
    </div>
  </div>

  <%# Comments Sidebar %>
  <div class="comments-sidebar">
    <div class="comments-sidebar__header">
      <h3>Comments (<%= @active_comments.size %>)</h3>
    </div>

    <div class="comments-sidebar__form">
      <%= render partial: "comments/form", locals: { document: @document, hide_guest_name: true } %>
    </div>

    <div class="comments-sidebar__list">
      <% if @active_comments.any? %>
        <%= render partial: "comments/comment", collection: @active_comments %>
      <% else %>
        <div class="empty-state--inline">
          <p>No comments yet. Be the first!</p>
        </div>
      <% end %>

      <% if @resolved_comments.any? %>
        <h4 class="resolved-heading">Resolved (<%= @resolved_comments.size %>)</h4>
        <%= render partial: "comments/comment", collection: @resolved_comments %>
      <% end %>
    </div>
  </div>
</div>
