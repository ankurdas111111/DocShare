<h1>Welcome, <%= current_user.name %>!</h1>

<%= link_to "Upload PDF", new_document_path %> |
<%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete } %>

<hr>

<h2>Your Documents</h2>

<%= form_with url: root_path, method: :get, local: true do |f| %>
  <%= f.text_field :query, value: params[:query], placeholder: "Search by filename..." %>
  <%= f.submit "Search" %>
  <% if params[:query].present? %>
    <%= link_to "Clear", root_path %>
  <% end %>
<% end %>

<% if @documents.any? %>
  <ul>
    <% @documents.each do |doc| %>
      <li><%= link_to doc.title, document_path(doc) %> — uploaded <%= time_ago_in_words(doc.created_at) %> ago</li>
    <% end %>
  </ul>

  <%== series_nav(@pagy) if @pagy.pages > 1 %>
<% else %>
  <% if params[:query].present? %>
    <p>No documents matching "<%= params[:query] %>".</p>
  <% else %>
    <p>No PDFs uploaded yet. <%= link_to "Upload your first PDF", new_document_path %>.</p>
  <% end %>
<% end %>
