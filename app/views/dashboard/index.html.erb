<h1>Welcome, <%= current_user.name %>!</h1>

<h2>Your Documents</h2>

<%= form_with url: root_path, method: :get, local: true, html: { class: "search-form", role: "search" } do |f| %>
  <label for="query" class="sr-only">Search documents</label>
  <%= f.text_field :query, value: params[:query], placeholder: "Search by filename...", aria: { label: "Search documents" } %>
  <%= f.submit "Search" %>
  <% if params[:query].present? %>
    <%= link_to "Clear", root_path %>
  <% end %>
<% end %>

<% if @documents.any? %>
  <ul class="doc-list">
    <% @documents.each do |doc| %>
      <li>
        <%= link_to doc.title, document_path(doc) %>
        <span class="doc-meta">uploaded <%= time_ago_in_words(doc.created_at) %> ago</span>
      </li>
    <% end %>
  </ul>

  <%== series_nav(@pagy) if @pagy.pages > 1 %>
<% else %>
  <div class="empty-state">
    <% if params[:query].present? %>
      <p>No documents matching "<%= params[:query] %>".</p>
    <% else %>
      <p>No PDFs uploaded yet.</p>
      <%= link_to "Upload your first PDF", new_document_path, class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>
