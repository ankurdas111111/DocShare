<h1><%= @document.title %></h1>

<p>
  Shared by <%= @document.user.name %>
</p>

<hr>

<div style="display: flex; gap: 20px;"
     data-controller="pdf-viewer"
     data-pdf-viewer-url-value="<%= rails_blob_path(@document.file, disposition: "inline") %>">

  <%# PDF Viewer %>
  <div style="flex: 1;">
    <p data-pdf-viewer-target="pageInfo" style="text-align: center; font-weight: bold;"></p>
    <div data-pdf-viewer-target="container"
         style="max-height: 800px; overflow-y: auto; border: 1px solid #ccc; background: #f5f5f5; padding: 8px;">
      <p style="text-align: center; color: #999;">Loading PDF...</p>
    </div>
  </div>

  <%# Comments Sidebar %>
  <div style="width: 350px; max-height: 850px; overflow-y: auto; border-left: 1px solid #ccc; padding-left: 16px;">
    <h3>Comments (<%= @document.comments.count %>)</h3>

    <%= form_with url: shared_document_comments_path(@share.token), method: :post, local: true do |f| %>
      <div class="field">
        <p><%= f.label :page_number, "Page #" %></p>
        <p><%= f.number_field :page_number, min: 1, placeholder: "Auto-detected", name: "comment[page_number]", data: { pdf_viewer_target: "pageNumberInput" } %></p>
      </div>

      <div class="field">
        <p><%= f.label :body, "Comment" %></p>
        <p><%= f.text_area :body, rows: 3, placeholder: "Write a comment...", name: "comment[body]" %></p>
      </div>

      <% unless user_signed_in? %>
        <div class="field">
          <p><%= f.label :guest_name, "Your Name" %></p>
          <p><%= f.text_field :guest_name, placeholder: "Enter your name", name: "comment[guest_name]" %></p>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Post Comment" %>
      </div>
    <% end %>

    <hr>

    <% if @document.comments.any? %>
      <%= render partial: "comments/comment", collection: @document.comments.order(created_at: :desc) %>
    <% else %>
      <p style="color: #999;">No comments yet.</p>
    <% end %>
  </div>
</div>
