<% document = comment.document %>
<% is_owner = defined?(current_user) && current_user == document.user %>
<% is_author = defined?(current_user) && comment.editable_by?(current_user) %>

<% if comment.resolved? %>
  <details class="comment--resolved">
    <summary>
      <strong><%= comment.author_name %></strong>
      <% if comment.page_number.present? %>
        <span class="comment__page">Page <%= comment.page_number %></span>
      <% end %>
      — <em>Resolved</em>
      <span class="comment__time">· <%= time_ago_in_words(comment.updated_at) %> ago</span>
    </summary>
    <div class="comment--resolved__content">
      <div class="comment__body comment-body"><%= render_markdown(comment.body) %></div>
      <span class="comment__time">Posted <%= time_ago_in_words(comment.created_at) %> ago</span>

      <% if comment.replies.any? %>
        <div class="replies">
          <% comment.replies.sort_by(&:created_at).each do |reply| %>
            <div class="reply">
              <span class="reply__author"><%= reply.author_name %></span>
              <span class="comment__time">· <%= time_ago_in_words(reply.created_at) %> ago</span>
              <div class="reply__body comment-body"><%= render_markdown(reply.body) %></div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if is_owner %>
        <div class="comment__actions">
          <%= button_to "Unresolve",
                toggle_resolved_document_comment_path(document, comment),
                method: :patch, class: "btn-sm" %>
        </div>
      <% end %>
    </div>
  </details>

<% else %>
  <div class="comment">
    <div class="comment__header">
      <span class="comment__author"><%= comment.author_name %></span>
      <% if comment.page_number.present? %>
        <span class="comment__page">Page <%= comment.page_number %></span>
      <% end %>
      <span class="comment__time"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>

    <div class="comment__body comment-body"><%= render_markdown(comment.body) %></div>

    <% if is_author || is_owner %>
      <div class="comment__actions">
        <% if is_author %>
          <% if local_assigns[:share_token] %>
            <%= link_to "Edit", edit_shared_document_comment_path(share_token, comment) %>
            <%= button_to "Delete",
                  shared_document_comment_path(share_token, comment),
                  method: :delete, class: "btn-delete",
                  data: { turbo_confirm: "Delete this comment?" } %>
          <% else %>
            <%= link_to "Edit", edit_document_comment_path(document, comment) %>
            <%= button_to "Delete",
                  document_comment_path(document, comment),
                  method: :delete, class: "btn-delete",
                  data: { turbo_confirm: "Delete this comment?" } %>
          <% end %>
        <% end %>
        <% if is_owner %>
          <%= button_to "Resolve",
                toggle_resolved_document_comment_path(document, comment),
                method: :patch, class: "btn-resolve" %>
        <% end %>
      </div>
    <% end %>

    <% if comment.replies.any? %>
      <div class="replies">
        <% comment.replies.sort_by(&:created_at).each do |reply| %>
          <div class="reply">
            <div class="comment__header">
              <span class="reply__author"><%= reply.author_name %></span>
              <span class="comment__time">· <%= time_ago_in_words(reply.created_at) %> ago</span>
            </div>
            <div class="reply__body comment-body"><%= render_markdown(reply.body) %></div>
            <% if defined?(current_user) && reply.editable_by?(current_user) %>
              <div class="comment__actions">
                <% if local_assigns[:share_token] %>
                  <%= link_to "Edit", edit_shared_document_comment_path(share_token, reply) %>
                  <%= button_to "Delete",
                        shared_document_comment_path(share_token, reply),
                        method: :delete, class: "btn-delete",
                        data: { turbo_confirm: "Delete this reply?" } %>
                <% else %>
                  <%= link_to "Edit", edit_document_comment_path(document, reply) %>
                  <%= button_to "Delete",
                        document_comment_path(document, reply),
                        method: :delete, class: "btn-delete",
                        data: { turbo_confirm: "Delete this reply?" } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if (defined?(current_user) && current_user) || local_assigns[:share_token] %>
      <details class="reply-toggle">
        <summary>Reply</summary>
        <div class="reply-toggle__content">
          <%= render partial: "comments/reply_form", locals: { document: document, parent: comment, share_token: local_assigns[:share_token] } %>
        </div>
      </details>
    <% end %>
  </div>
<% end %>
