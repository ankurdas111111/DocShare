<div class="markdown-toolbar" style="display: flex; gap: 4px; margin-bottom: 4px;">
  <button type="button" data-action="markdown-toolbar#bold"
          title="Bold (wrap with **)"
          style="font-weight: bold; padding: 2px 8px; font-size: 13px; cursor: pointer; border: 1px solid #ccc; border-radius: 3px; background: #f9f9f9;">
    B
  </button>
  <button type="button" data-action="markdown-toolbar#italic"
          title="Italic (wrap with _)"
          style="font-style: italic; padding: 2px 8px; font-size: 13px; cursor: pointer; border: 1px solid #ccc; border-radius: 3px; background: #f9f9f9;">
    I
  </button>
  <button type="button" data-action="markdown-toolbar#bullet"
          title="Bullet list (prefix with -)"
          style="padding: 2px 8px; font-size: 13px; cursor: pointer; border: 1px solid #ccc; border-radius: 3px; background: #f9f9f9;">
    &bull; List
  </button>
  <small style="color: #999; align-self: center; margin-left: 4px;">Markdown supported</small>
</div>
