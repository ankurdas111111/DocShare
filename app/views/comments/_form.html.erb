<%= form_with(model: [document, Comment.new], local: true) do |f| %>
  <div class="field">
    <p><%= f.label :page_number, "Page #" %></p>
    <p><%= f.number_field :page_number, min: 1, placeholder: "Auto-detected", data: { pdf_viewer_target: "pageNumberInput" } %></p>
  </div>

  <div class="field" data-controller="markdown-toolbar">
    <p><%= f.label :body, "Comment" %></p>
    <%= render "comments/markdown_toolbar" %>
    <p><%= f.text_area :body, rows: 3, placeholder: "Write a comment... (supports **bold**, _italic_, - bullets)", data: { markdown_toolbar_target: "textarea" } %></p>
  </div>

  <% unless local_assigns[:hide_guest_name] %>
    <% unless defined?(current_user) && current_user %>
      <div class="field">
        <p><%= f.label :guest_name, "Your Name" %></p>
        <p><%= f.text_field :guest_name, placeholder: "Enter your name" %></p>
      </div>
    <% end %>
  <% end %>

  <div class="actions">
    <%= f.submit "Post Comment" %>
  </div>
<% end %>
