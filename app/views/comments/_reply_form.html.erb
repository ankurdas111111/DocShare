<%# Use shared endpoint when share_token is present, otherwise use the authenticated route %>
<% form_url = local_assigns[:share_token] ? shared_document_comments_path(share_token) : document_comments_path(document) %>

<%= form_with(url: form_url, method: :post, local: true) do |f| %>
  <%= f.hidden_field :parent_id, value: parent.id, name: "comment[parent_id]" %>

  <div class="comment-composer comment-composer--compact" data-controller="markdown-toolbar">
    <%= render "comments/markdown_toolbar" %>
    <div class="comment-composer__editable is-empty"
         contenteditable="true"
         data-placeholder="Write a reply..."
         data-markdown-toolbar-target="editor"
         data-action="input->markdown-toolbar#sync paste->markdown-toolbar#handlePaste keydown->markdown-toolbar#handleKeydown"></div>
    <textarea name="comment[body]" data-markdown-toolbar-target="input" class="comment-composer__hidden"></textarea>

    <% unless defined?(current_user) && current_user %>
      <div class="comment-composer__guest">
        <%= f.text_field :guest_name, id: "reply_guest_#{parent.id}", placeholder: "Your name", name: "comment[guest_name]", class: "comment-composer__guest-input" %>
      </div>
    <% end %>

    <div class="comment-composer__actions">
      <%= f.submit "Reply", class: "btn btn-secondary btn-sm" %>
    </div>
  </div>
<% end %>
