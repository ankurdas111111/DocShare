# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Development (Docker PostgreSQL — run: docker compose up -d) ──
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=secret

# ── Production (set these on Render) ─────────────────────────────
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # Provided by Render
# RAILS_MASTER_KEY=<contents of config/master.key>
# SECRET_KEY_BASE=<auto-generated by Render>

# APP_HOST=your-app.onrender.com          # Required for host protection & mailer links

# STORAGE_SERVICE=cloudinary               # Activates Cloudinary for Active Storage
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# RESEND_API_KEY=re_xxxxxxxxxxxx           # Email delivery via Resend
# MAILER_SENDER=DocShare <onboarding@resend.dev>  # OR verified domain sender
